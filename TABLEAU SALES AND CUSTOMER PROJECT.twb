    <worksheet name='SUBCATEGORY COMPARISON'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#b07aa1' fontname='Copperplate Gothic Bold'>SUBCATEGORY COMPARISON</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Orders+' name='federated.0x5klyu070ksf917w08um0cn93a0' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='SELECT YEAR' datatype='integer' default-format='n0;-0' name='[Parameter 0996737593475075]' param-domain-type='list' role='measure' type='quantitative' value='2023'>
              <calculation class='tableau' formula='2023' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0x5klyu070ksf917w08um0cn93a0'>
            <column caption='KPI  CY Less PY' datatype='string' name='[Calculation_0950009393958912]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF SUM([Calculation_0996737591496704])&lt; SUM([Calculation_0996737592553473]) THEN &apos;⬤&apos;&#13;&#10; ELSE&apos;&apos;&#13;&#10;END' />
            </column>
            <column caption='CY Sales' datatype='real' name='[Calculation_0996737591496704]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([Order Date])= ([Parameters].[Parameter 0996737593475075]) THEN [Sales]&#13;&#10;END' />
            </column>
            <column caption='PY Sales' datatype='real' name='[Calculation_0996737592553473]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR ([Order Date])=([Parameters].[Parameter 0996737593475075])-1 THEN [Sales] END' />
            </column>
            <column caption='Order date' datatype='date' datatype-customized='true' name='[Calculation_0996737593184258]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATEPARSE ( &quot;yyyy&quot;, STR(YEAR([Order Date])) )) ' />
            </column>
            <column caption='CY PROFIT' datatype='real' name='[Calculation_1131428365553667]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([Calculation_0996737593184258]) = [Parameters].[Parameter 0996737593475075] THEN [Profit] END' />
            </column>
            <column datatype='date' name='[Order Date]' role='dimension' type='ordinal' />
            <column datatype='real' datatype-customized='true' name='[Profit]' role='measure' type='quantitative' />
            <column datatype='real' datatype-customized='true' name='[Sales]' role='measure' type='quantitative' />
            <column datatype='string' name='[Sub-Category]' role='dimension' type='nominal' />
            <column-instance column='[Sub-Category]' derivation='None' name='[none:Sub-Category:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_0996737591496704]' derivation='Sum' name='[sum:Calculation_0996737591496704:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0996737592553473]' derivation='Sum' name='[sum:Calculation_0996737592553473:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1131428365553667]' derivation='Sum' name='[sum:Calculation_1131428365553667:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0950009393958912]' derivation='User' name='[usr:Calculation_0950009393958912:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
